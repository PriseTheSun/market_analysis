# Generate local secrets without printing them: pnpm setup:local
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
DB_MIGRATION_PASSWORD=replace-with-local-secret
DB_RUNTIME_PASSWORD=replace-with-different-local-secret
DATABASE_URL=postgresql://market_runtime:replace-with-different-local-secret@localhost:55432/market_analysis
MIGRATION_DATABASE_URL=postgresql://market_migrator:replace-with-local-secret@localhost:55432/market_analysis
SESSION_SECRET=replace-with-64-hex-characters
OUTBOX_KEY=replace-with-64-hex-characters
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=market-analysis
S3_ACCESS_KEY=replace-with-local-key
S3_SECRET_KEY=replace-with-local-secret
UPLOAD_MAX_BYTES=26214400
TENANT_STORAGE_MAX_BYTES=1073741824
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Market Analysis <no-reply@marketanalysis.local>
CHAT_PROVIDER=demo
CHAT_TIMEOUT_MS=120000
CHAT_OUTPUT_MAX_CHARS=32000
# Production requires external TLS, storage/SMTP configuration, and an authorized AI adapter.

# Optional per-bucket limits; windows remain documented by endpoint.
RATE_LIMITS_JSON={"login":20,"login.ip":100,"recover":5,"upload":30,"chat":30}
